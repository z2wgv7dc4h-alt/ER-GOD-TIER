# Gideon's optional LLM. Copy to `.env.local` (gitignored) and restart the dev
# server — Vite only reads env at startup. Leave VITE_GIDEON_API_KEY empty to
# stay router-only: without a key the app never calls a provider.

# Your provider key. The key is embedded in the client bundle (Vite inlines
# VITE_*), so this is LAN-only: do not deploy it publicly.
VITE_GIDEON_API_KEY=

# Which provider to talk to: `deepseek` or `meta`.
# Omit (or leave empty) to infer from VITE_GIDEON_BASE_URL, else `meta`.
VITE_GIDEON_PROVIDER=

# Optional base-URL override. Leave empty to use the dev proxy (no CORS) or the
# provider default in production.
#   deepseek → https://api.deepseek.com/v1      dev proxy /gideon-llm-deepseek/v1
#   meta     → https://api.meta.ai/v1           dev proxy /gideon-llm/v1
VITE_GIDEON_BASE_URL=

# Optional model override. Leave empty for the provider default.
#   deepseek → deepseek-chat   (or deepseek-reasoner for the reasoning model)
#   meta     → muse-spark-1.3-contributor
VITE_GIDEON_MODEL=
