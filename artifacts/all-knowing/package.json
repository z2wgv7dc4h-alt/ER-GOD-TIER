{
  "name": "all-knowing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev-stack.mjs",
    "start:live": "node scripts/dev-stack.mjs --live-memory",
    "dev": "vite",
    "cert": "node scripts/make-dev-cert.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:bundle": "npm run build && vitest run src/lib/bundleBudget.test.ts",
    "test:ocr": "vitest run --config vitest.ocr.config.ts",
    "audit:ui": "node scripts/ui-audit.mjs",
    "audit:inference": "node scripts/inference-audit.mjs",
    "crawl:ui": "node scripts/ui-crawl.mjs",
    "index:entities": "node scripts/build-entity-index.mjs",
    "coverage:entities": "node scripts/entity-coverage.mjs",
    "data:catalog": "node scripts/data-catalog.mjs",
    "data:offline": "node scripts/build-offline-manifest.mjs",
    "preview": "vite preview",
    "map": "node vendor/elden-ring-map/server/index.js",
    "map:live": "node vendor/elden-ring-map/server/index.js --live-memory",
    "map:setup": "python vendor/elden-ring-map/tools/extract_tiles.py && python vendor/elden-ring-map/tools/build_markers.py && python vendor/elden-ring-map/tools/extract_place_names.py && python vendor/elden-ring-map/tools/find_map_banners.py",
    "map:banners": "python vendor/elden-ring-map/tools/find_map_banners.py",
    "map:merge": "python scripts/merge-engine-markers.py",
    "audit:links": "node scripts/links-audit.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@paulmillr/qr": "0.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
